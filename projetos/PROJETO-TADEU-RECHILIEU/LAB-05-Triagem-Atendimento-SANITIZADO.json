    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0d58bcff-c7dc-45c4-bbbe-1f3142f0ca78",
              "name": "resposta",
              "value": "Olá! 😊 Obrigado pelo seu contato.  O prazo de produção e entrega pode variar conforme o produto e os detalhes do pedido.  Para informar uma previsão correta, nossa equipe precisa consultar as condições do seu pedido. Em breve, retornaremos com essa informação!",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
