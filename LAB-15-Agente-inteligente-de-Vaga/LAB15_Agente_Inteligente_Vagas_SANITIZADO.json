      "parameters": {
        "jsonSchemaExample": "{\n  \"nota_compatibilidade\": 34,\n  \"classificacao\": \"BAIXA\",\n  \"pontos_fortes\": [\n    \"Conhecimento prático em n8n e automação de processos\",\n    \"Experiência com APIs REST e integrações\"\n  ],\n  \"requisitos_atendidos\": [\n    \"Experiência com processos administrativos\",\n    \"Formação complementar em automação com n8n\"\n  ],\n  \"lacunas\": [\n    \"Ausência de experiência com Tosca\",\n    \"Ausência de experiência em automação de testes\"\n  ],\n  \"competencias_transferiveis\": [\n    \"Lógica de automação\",\n    \"Validação e tratamento de dados\"\n  ],\n  \"analise_modalidade_senioridade\": \"Modalidade remota compatível; experiência técnica específica insuficiente.\",\n  \"recomendacao\": \"NAO_PRIORIZAR\",\n  \"justificativa\": \"A vaga exige conhecimentos específicos que não estão comprovados no perfil.\"\n}"
      },
