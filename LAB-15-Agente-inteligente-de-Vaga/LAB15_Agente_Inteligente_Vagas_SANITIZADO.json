        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "={{\n'🤖 AGENTE INTELIGENTE DE VAGAS\\n\\n' +\n'📌 ' + $json.titulo + '\\n' +\n'🏢 Empresa: ' + $json.empresa + '\\n' +\n'📍 Local: ' + $json.cidade + '\\n' +\n'💻 Modalidade: ' + $json.modalidade + '\\n\\n' +\n'🎯 COMPATIBILIDADE: ' + $json.output.nota_compatibilidade + '/100\\n' +\n'📊 Classificação: ' + $json.output.classificacao.toUpperCase() + '\\n' +\n'📢 Recomendação: ' + $json.output.recomendacao + '\\n\\n' +\n'💪 PONTOS FORTES\\n' +\n$json.output.pontos_fortes.map(x => '• ' + x).join('\\n') + '\\n\\n' +\n'⚠️ LACUNAS IDENTIFICADAS\\n' +\n$json.output.lacunas.map(x => '• ' + x).join('\\n') + '\\n\\n' +\n'🧠 JUSTIFICATIVA\\n' +\n$json.output.justificativa + '\\n\\n' +\n'🔗 ACESSAR VAGA:\\n' + $json.url_vaga + '\\n\\n' +\n'📝 CANDIDATURA:\\n' + $json.url_candidatura\n}}",
