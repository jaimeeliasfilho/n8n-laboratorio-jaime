    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction calcularDV(base, pesos) {\n  const soma = base.split('').reduce((total, caractere, i) => {\n    return total + (caractere.charCodeAt(0) - 48) * pesos[i];\n  }, 0);\n\n  const resto = soma % 11;\n  return resto < 2 ? 0 : 11 - resto;\n}\n\nreturn items.map(item => {\n  const original = String(item.json.CNPJ || '');\n\n  const cnpj = original.toUpperCase().replace(/[^A-Z0-9]/g, '');\n\n  if (cnpj.length !== 14 || !/^[A-Z0-9]{12}\\d{2}$/.test(cnpj)) {\n    throw new Error('CNPJ inválido: formato incorreto.');\n  }\n\n  if (/^([A-Z0-9])\\1{13}$/.test(cnpj)) {\n    throw new Error('CNPJ inválido: caracteres repetidos.');\n  }\n\n  const dv1 = calcularDV(\n    cnpj.substring(0, 12),\n    [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]\n  );\n\n  const dv2 = calcularDV(\n    cnpj.substring(0, 12) + dv1,\n    [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]\n  );\n\n  if (!cnpj.endsWith(`${dv1}${dv2}`)) {\n    throw new Error('CNPJ inválido: dígitos verificadores incorretos.');\n  }\n\n  return {\n    json: {\n      ...item.json,\n      cnpj_normalizado: cnpj,\n      cnpj_valido: true\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
